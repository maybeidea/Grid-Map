Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Ground grid
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Gemini 336 point cloud
      Topic: /camera/depth/points
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 120; 190; 240
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: True U scene and rear wall
      Topic: /scene/ground_truth
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 230; 80; 55
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Scene geometry, original map range, observations
      Topic: /scene/reference_markers
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: 3D occupied voxels
      Topic: /grid_map/occupied_voxels
      Style: Squares
      Size (Pixels): 5
      Color Transformer: Intensity
      Autocompute Intensity Bounds: false
      Min Intensity: 0.8
      Max Intensity: 1.0
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: ESDF slice
      Topic: /grid_map/esdf_slice
      Style: Points
      Size (Pixels): 3
      Color Transformer: Intensity
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Height classification
      Topic: /grid_map/heightmap
      Alpha: 0.75
      Color Scheme: costmap
  Global Options:
    Background Color: 30; 35; 40
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.5
      Focal Point: 0; 0; 0.6
      Pitch: 0.65
      Yaw: 0.8
      Target Frame: map
